# Blink panel API — environment configuration
# Copy to .env and adjust. Generate secrets with: openssl rand -hex 32
#
# Port the API server listens on
PORT=3000

# Public URL of this panel (used when signing cargo download URLs for nodes).
# Must be reachable from your nodes.
APP_URL=http://localhost:3000

# Secret used to sign session JWTs. REQUIRED in production.
JWT_SECRET=replace-me-with-openssl-rand-hex-32

# Secret used to sign cargo download URLs handed to nodes. REQUIRED in production.
APP_KEY=replace-me-with-openssl-rand-hex-32

# Grant admin permissions to the first registered user
FIRST_USER_HAS_ADMIN=true

# NODE_ENV=production
